      },
      "source": [
        "# SoniTranslate\n",
        "\n",
        "Installation compatible avec l'environnement Colab actuel.\n",
        "\n",
        "### Configuration\n",
        "- Python 3.10 via UV\n",
        "- PyTorch 2.5.1 + CUDA 12.4\n",
        "- SoniTranslate\n",
        "- WhisperX\n",
        "- RVC\n",
        "- Kokoro TTS\n",
        "- Piper TTS\n",
        "- Coqui XTTS\n",
        "- Google GenAI\n",
        "\n",
        "### Moteurs volontairement désactivés\n",
        "- F5-TTS\n",
        "- Chatterbox\n",
        "- OmniVoice\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "cellView": "form",
        "id": "install-sonitranslate"
      },
      "outputs": [],
      "source": [
        "# @title Installation complète de SoniTranslate\n",
        "\n",
        "# ============================================================\n",
        "# 0. CLONAGE\n",
        "# ============================================================\n",
        "%cd /content\n",
        "!rm -rf /content/SoniTranslate\n",
        "!git clone https://github.com/moussa822/SoniTranslate.git\n",
        "%cd /content/SoniTranslate\n",
        "\n",
        "# ============================================================\n",
        "# 1. NETTOYAGE DE COLAB\n",
        "# ============================================================\n",
        "!pip uninstall -y chex pandas-stubs ibis-framework albumentations albucore jax -q || true\n",
        "\n",
        "# ============================================================\n",
        "# 2. INSTALLATION DE UV\n",
        "# ============================================================\n",
        "!pip install -q uv==0.8.13\n",
        "\n",
        "# Création d'un environnement isolé Python 3.10\n",
        "!uv venv --python 3.10 --clear\n",
        "\n",
        "print('===== VERSION PYTHON =====')\n",
        "!uv run python --version\n",
        "\n",
        "# ============================================================\n",
        "# 3. PIP / SETUPTOOLS / WHEEL\n",
        "# ============================================================\n",
        "!curl -sS https://bootstrap.pypa.io/get-pip.py -o get-pip.py\n",
        "!uv run python get-pip.py pip==23.1.2 -q\n",
        "!uv run python -m pip install -q pip==23.1.2 setuptools==80.6.0 wheel\n",
        "\n",
        "# ============================================================\n",
        "# 4. GIT LFS\n",
        "# ============================================================\n",
        "!apt-get update -qq\n",
        "!apt-get install -y git-lfs -qq\n",
        "!git lfs install\n",
        "\n",
        "# ============================================================\n",
        "# 5. PYTORCH 2.5.1 + CUDA 12.4\n",
        "# ============================================================\n",
        "!uv run python -m pip install -q torch==2.5.1 torchvision==0.20.1 torchaudio==2.5.1 --index-url https://download.pytorch.org/whl/cu124\n",
        "\n",
        "print('===== PYTORCH =====')\n",
        "!uv run python -c \"import torch; print('PyTorch:', torch.__version__); print('CUDA PyTorch:', torch.version.cuda); print('CUDA disponible:', torch.cuda.is_available()); print('GPU:', torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'Aucun')\"\n",
        "\n",
        "# ============================================================\n",
        "# 6. DÉPENDANCES SYSTÈME\n",
        "# ============================================================\n",
        "!apt-get install -y ffmpeg espeak-ng -qq\n",
        "\n",
        "# ============================================================\n",
        "# 7. PYTHON DEPENDENCIES - BASE\n",
        "# ============================================================\n",
        "# IMPORTANT : on utilise requirements_base.txt du dépôt.\n",
        "!uv run python -m pip install -r requirements_base.txt\n",
        "\n",
        "# ============================================================\n",
        "# 8. GOOGLE GENAI\n",
        "# ============================================================\n",
        "!uv run python -m pip install -q google-genai\n",
        "\n",
        "# ============================================================\n",
        "# 9. EXTRA DEPENDENCIES\n",
        "# ============================================================\n",
        "!uv run python -m pip install -r requirements_extra.txt\n",
        "\n",
        "!uv run python -m pip install -q onnxruntime-gpu==1.22.0\n",
        "\n",
        "# ============================================================\n",
        "# 10. KOKORO TTS\n",
        "# ============================================================\n",
        "!uv run python -m pip install -q kokoro soundfile\n",
        "\n",
        "# ============================================================\n",
        "# 11. PIPER TTS\n",
        "# ============================================================\n",
        "Install_PIPER_TTS = True  # @param {type:\"boolean\"}\n",
        "\n",
        "if Install_PIPER_TTS:\n",
        "    !uv run python -m pip install -q piper-tts==1.2.0\n",
        "\n",
        "# ============================================================\n",
        "# 12. COQUI XTTS\n",
        "# ============================================================\n",
        "Install_Coqui_XTTS = True  # @param {type:\"boolean\"}\n",
        "\n",
        "if Install_Coqui_XTTS:\n",
        "    !uv run python -m pip install -q -r requirements_xtts.txt\n",
        "    !uv run python -m pip install -q TTS==0.21.1 --no-deps\n",
        "\n",
        "# ============================================================\n",
        "# 13. CUDNN\n",
        "# ============================================================\n",
        "!apt-get install -y libcudnn8 -qq || true\n",
        "\n",
        "# ============================================================\n",
        "# 14. VÉRIFICATION DES MODULES PRINCIPAUX\n",
        "# ============================================================\n",
        "print('')\n",
        "print('==============================================')\n",
        "print('       VÉRIFICATION SONITRANSLATE')\n",
        "print('==============================================')\n",
        "\n",
        "!uv run python --version\n",
        "!uv run python -c \"import torch; print('PyTorch        :', torch.__version__); print('CUDA PyTorch   :', torch.version.cuda); print('CUDA disponible:', torch.cuda.is_available()); print('GPU            :', torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'Aucun')\"\n",
        "\n",
        "print('')\n",
        "print('Moteurs installés :')\n",
        "print('  ✓ SoniTranslate')\n",
        "print('  ✓ WhisperX')\n",
        "print('  ✓ RVC')\n",
        "print('  ✓ Kokoro')\n",
        "print('  ✓ Piper')\n",
        "print('  ✓ Coqui XTTS')\n",
        "print('  ✓ Google GenAI')\n",
        "print('')\n",
        "print('Moteurs désactivés :')\n",
        "print('  ✗ F5-TTS')\n",
        "print('  ✗ Chatterbox')\n",
        "print('  ✗ OmniVoice')\n",
        "print('==============================================')\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "pyannote-license"
      },
      "source": [
        "## Pyannote\n",
        "\n",
        "Pour utiliser la diarisation des locuteurs, acceptez les licences Hugging Face de :\n",
        "\n",
        "- pyannote/speaker-diarization\n",
        "- pyannote/segmentation\n",
        "\n",
        "Puis créez un token Hugging Face avec accès en lecture."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "cellView": "form",
        "id": "run-sonitranslate"
      },
      "outputs": [],
      "source": [
        "#@markdown ## RUN THE WEB APP\n",
        "\n",
        "YOUR_HF_TOKEN = ''  # @param {type:'string'}\n",
        "openai_api_key = ''  # @param {type:'string'}\n",
        "google_api_key = ''  # @param {type:'string'}\n",
        "groq_api_key = ''  # @param {type:'string'}\n",
        "elevenlabs_api_key = ''  # @param {type:'string'}\n",
        "\n",
        "theme = 'Taithrah/Minimal'  # @param ['Taithrah/Minimal', 'aliabid94/new-theme', 'gstaff/xkcd', 'ParityError/LimeFace', 'abidlabs/pakistan', 'rottenlittlecreature/Moon_Goblin', 'ysharma/llamas', 'gradio/dracula_revamped']\n",
        "interface_language = 'french'  # @param ['arabic','azerbaijani','chinese_zh_cn','english','french','german','hindi','indonesian','italian','japanese','korean','marathi','polish','portuguese','russian','spanish','swedish','turkish','ukrainian','vietnamese']\n",
        "verbosity_level = 'info'  # @param ['debug','info','warning','error','critical']\n",
        "\n",
        "import os\n",
        "\n",
        "# ============================================================\n",
        "# CACHE PERSISTANT GOOGLE DRIVE\n",
        "# ============================================================\n",
        "if os.path.exists('/content/drive/MyDrive'):\n",
        "    !mkdir -p /content/drive/MyDrive/SoniTranslate_Cache\n",
        "    !ln -sf /content/drive/MyDrive/SoniTranslate_Cache /content/SoniTranslate/persistent_cache\n",
        "    print('--- Cache persistant Google Drive activé ---')\n",
        "\n",
        "%cd /content/SoniTranslate\n",
        "\n",
        "# ============================================================\n",
        "# VARIABLES D'ENVIRONNEMENT\n",
        "# ============================================================\n",
        "cmd_env = ''\n",
        "\n",
        "if YOUR_HF_TOKEN:\n",
        "    cmd_env += f\"YOUR_HF_TOKEN='{YOUR_HF_TOKEN}' \"\n",
        "\n",
        "if openai_api_key:\n",
        "    cmd_env += f\"OPENAI_API_KEY='{openai_api_key}' \"\n",
        "\n",
        "if google_api_key:\n",
        "    cmd_env += f\"GOOGLE_API_KEY='{google_api_key}' \"\n",
        "\n",
        "if groq_api_key:\n",
        "    cmd_env += f\"GROQ_API_KEY='{groq_api_key}' \"\n",
        "\n",
        "if elevenlabs_api_key:\n",
        "    cmd_env += f\"ELEVEN_API_KEY='{elevenlabs_api_key}' \"\n",
        "\n",
        "# ============================================================\n",
        "# LANCEMENT DANS LE .venv PYTHON 3.10\n",
        "# ============================================================\n",
        "!{cmd_env} uv run python app_rvc.py --theme {theme} --verbosity_level {verbosity_level} --language {interface_language} --public_url\n"
      ]
    },
